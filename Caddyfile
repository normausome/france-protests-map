:{$PORT:8080} {
	root * {$SITE_ROOT:/srv}
	encode zstd gzip
	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Content-Security-Policy "default-src 'self'; img-src 'self' data: https://tile.openstreetmap.org; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'none'"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}
	# vendor/ paths carry the library version, so they never change in place.
	header /vendor/* Cache-Control "public, max-age=31536000, immutable"
	@assets path /style.css /app.js /favicon.svg
	header @assets Cache-Control "public, max-age=300, must-revalidate"
	@fresh path / /index.html /data/*
	header @fresh Cache-Control "no-cache"
	file_server
}
